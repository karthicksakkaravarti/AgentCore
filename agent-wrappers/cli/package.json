{
  "name": "agent-core-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CLI wrapper for the reusable agent-core library.",
  "bin": {
    "agent-core": "./dist/cli.js"
  },
  "scripts": {
    "dev": "npm --prefix ../../agent-core run build && tsx src/cli.ts",
    "build": "npm --prefix ../../agent-core run build && tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "typecheck": "npm --prefix ../../agent-core run build && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agent-core/core": "file:../../agent-core",
    "chalk": "^5.4.1",
    "dotenv": "^16.4.7",
    "figlet": "^1.8.0",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@types/figlet": "^1.7.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
