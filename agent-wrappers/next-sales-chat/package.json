    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "postcss": "^8.5.14"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
