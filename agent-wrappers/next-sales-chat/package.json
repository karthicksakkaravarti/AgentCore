{
  "name": "agent-core-next-sales-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Next.js sales chat sample powered by agent-core.",
  "scripts": {
    "dev": "npm --prefix ../../agent-core run build && next dev --webpack",
    "build": "npm --prefix ../../agent-core run build && next build --webpack",
