{
  "name": "@agent-core/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone TypeScript agent core migrated from the source Claude-style coding agent.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.60.0",
    "@google/genai": "^1.52.0",
    "@supabase/supabase-js": "^2.105.3",
    "fast-glob": "^3.3.3",
    "openai": "^6.36.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
